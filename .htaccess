# Ka Kha Ga: Apache / LiteSpeed config for shared hosting (the Netlify equivalent is netlify.toml).

# Framer's scripts are ES modules (.mjs) and CMS data (.framercms); browsers refuse modules served with a wrong type.
<IfModule mod_mime.c>
  AddType text/javascript .mjs
  AddType application/json .framercms
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddDefaultCharset UTF-8
</IfModule>

# Blog posts are rendered client-side from CMS data: any /collection/<slug> (refresh, shared link) gets the article shell.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^collection/([^/]+)/$ /collection/$1 [R=301,L]
  RewriteCond %{REQUEST_URI} ^/collection/[^/]+$
  RewriteRule ^ /collection/integrated-communications-in-2026/index.html [L]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Caching: hashed assets forever, HTML always revalidated
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(png|jpe?g|webp|svg|woff2|mp4|mjs|framercms)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
